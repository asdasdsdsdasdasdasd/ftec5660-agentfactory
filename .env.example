# Meta Agent Configuration (DeepSeek V4.1 Flash 1017)
META_AGENT_URL=https://api.deepseek.com
META_AGENT_API_KEY=<Your DeepSeek API Key Here>
META_AGENT_MODEL=deepseek-flash
META_AGENT_PROTOCOL=OPENAI_STYLE

# Subagent Configuration (local Qwen3.8 via Strata / llama-server)
SUBAGENT_URL=http://127.0.0.1:8080/v1
SUBAGENT_API_KEY=none
SUBAGENT_MODEL=Qwen3.8-27B-Q4_K_M
SUBAGENT_PROTOCOL=OPENAI_STYLE

# Search/Fetch use the DeepSeek Search API with META_AGENT_API_KEY / DEEPSEEK_API_KEY.
# SERPER_API_KEY and JINA_API_KEY are unused in this reproduction.

